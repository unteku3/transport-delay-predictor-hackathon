{
  "openapi": "3.1.0",
  "info": {
    "title": "Predictor ML · Optuna features v2",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/model/info": {
      "get": {
        "summary": "Info",
        "operationId": "info_model_info_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelInfo"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "summary": "Predict",
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/train": {
      "post": {
        "summary": "Train",
        "operationId": "train_train_post",
        "responses": {
          "501": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelInfo": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "training_date": {
            "type": "string",
            "title": "Training Date"
          },
          "training_date_source": {
            "type": "string",
            "title": "Training Date Source"
          },
          "validation_mae_sec": {
            "type": "number",
            "title": "Validation Mae Sec"
          },
          "validation_protocol": {
            "type": "string",
            "title": "Validation Protocol"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "features": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Features"
          },
          "probability_available": {
            "type": "boolean",
            "title": "Probability Available"
          },
          "individual_error_interval_available": {
            "type": "boolean",
            "title": "Individual Error Interval Available"
          },
          "causes_available": {
            "type": "boolean",
            "title": "Causes Available"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "training_date",
          "training_date_source",
          "validation_mae_sec",
          "validation_protocol",
          "target",
          "features",
          "probability_available",
          "individual_error_interval_available",
          "causes_available"
        ],
        "title": "ModelInfo"
      },
      "PredictRequest": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PredictionItem"
            },
            "type": "array",
            "maxItems": 512,
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "PredictRequest"
      },
      "PredictResponse": {
        "properties": {
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/Prediction"
            },
            "type": "array",
            "title": "Predictions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model_version",
          "predictions"
        ],
        "title": "PredictResponse"
      },
      "Prediction": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "delay_sec": {
            "type": "number",
            "title": "Delay Sec"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "delay_sec"
        ],
        "title": "Prediction"
      },
      "PredictionItem": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "features": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Features"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "features"
        ],
        "title": "PredictionItem"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}

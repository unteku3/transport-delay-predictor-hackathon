          },
          "fallback_mae_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallback Mae Min"
          },
          "stream": {
            "$ref": "#/components/schemas/SystemStatus"
          },
          "evaluation_scope": {
            "type": "string",
            "title": "Evaluation Scope",
            "default": "Development replay, frozen offline fit; not held-out online accuracy"
          }

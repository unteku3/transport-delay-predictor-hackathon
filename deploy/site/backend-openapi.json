{
  "openapi": "3.1.0",
  "info": {
    "title": "Predictor Dispatch Backend",
    "version": "1.0"
  },
  "paths": {
    "/api/network/summary": {
      "get": {
        "summary": "Summary",
        "operationId": "summary_api_network_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NetworkSummary"
                }
              }
            }
          }
        }
      }
    },
    "/api/vehicles": {
      "get": {
        "summary": "Vehicles",
        "operationId": "vehicles_api_vehicles_get",
        "parameters": [
          {
            "name": "route_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Route Id"
            }
          },
          {
            "name": "risk",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(ok|risk|high)$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Risk"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Type"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VehicleState"
                  },
                  "title": "Response Vehicles Api Vehicles Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/map/tracks": {
      "get": {
        "summary": "Map Tracks",
        "description": "Accepted GPS available in the stream, last 30 virtual minutes, bounded memory.",
        "operationId": "map_tracks_api_map_tracks_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/VehicleTrack"
                  },
                  "type": "array",
                  "title": "Response Map Tracks Api Map Tracks Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/alerts": {
      "get": {
        "summary": "Alerts",
        "operationId": "alerts_api_alerts_get",
        "parameters": [
          {
            "name": "route_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Route Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Alert"
                  },
                  "title": "Response Alerts Api Alerts Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/routes": {
      "get": {
        "summary": "Routes",
        "operationId": "routes_api_routes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RouteInfo"
                  },
                  "type": "array",
                  "title": "Response Routes Api Routes Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/routes/{id}": {
      "get": {
        "summary": "Route",
        "operationId": "route_api_routes__id__get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/routes/{id}/timeline": {
      "get": {
        "summary": "Timeline",
        "operationId": "timeline_api_routes__id__timeline_get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^plan$",
              "default": "plan",
              "title": "Direction"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteTimeline"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/segments/problems": {
      "get": {
        "summary": "Problems",
        "operationId": "problems_api_segments_problems_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemSegments"
                }
              }
            }
          }
        }
      }
    },
    "/api/whatif": {
      "post": {
        "summary": "Whatif",
        "operationId": "whatif_api_whatif_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhatIfRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhatIfResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "summary": "Metrics",
        "operationId": "metrics_api_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Metrics"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo/control": {
      "post": {
        "summary": "Control",
        "operationId": "control_api_demo_control_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmulatorControl"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Alert": {
        "properties": {
          "alert_id": {
            "type": "string",
            "title": "Alert Id"
          },
          "vehicle_id": {
            "type": "string",
            "title": "Vehicle Id"
          },
          "route_id": {
            "type": "string",
            "title": "Route Id"
          },
          "target_event_id": {
            "type": "string",
            "title": "Target Event Id"
          },
          "segment_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Segment Id"
          },
          "segment_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Segment Name"
          },
          "delay_probability": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delay Probability"
          },
          "predicted_delay_min": {
            "type": "number",
            "title": "Predicted Delay Min"
          },
          "predicted_error_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Predicted Error Min"
          },
          "event_time": {
            "type": "string",
            "title": "Event Time"
          },
          "issued_at": {
            "type": "string",
            "title": "Issued At"
          },
          "lead_time_min": {
            "type": "number",
            "title": "Lead Time Min"
          },
          "cause_code": {
            "type": "string",
            "title": "Cause Code"
          },
          "cause_text": {
            "type": "string",
            "title": "Cause Text"
          },
          "evidence": {
            "type": "string",
            "title": "Evidence"
          },
          "recommendations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "source": {
            "type": "string",
            "enum": [
              "live",
              "historical"
            ],
            "title": "Source"
          },
          "prediction_method": {
            "type": "string",
            "title": "Prediction Method"
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "ok",
              "risk",
              "high"
            ],
            "title": "Risk Level"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "confirmed",
              "false",
              "unverified"
            ],
            "title": "Status",
            "default": "open"
          },
          "actual_delay_min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual Delay Min"
          },
          "resolved_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "alert_id",
          "vehicle_id",
          "route_id",
          "target_event_id",
          "predicted_delay_min",
          "event_time",
          "issued_at",
          "lead_time_min",
          "cause_code",
          "cause_text",
          "evidence",
          "recommendations",
          "source",
          "prediction_method",
          "risk_level"
        ],
        "title": "Alert"
      },
      "EmulatorControl": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "disconnect",
              "reconnect",
              "speed"
            ],
            "title": "Action"
          },
          "speed": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 120.0,
                "minimum": 0.1
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action"
        ],
        "title": "EmulatorControl"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Metrics": {
